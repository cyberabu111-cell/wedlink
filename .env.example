# Copy to .env.local; enter your project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: verified payment updates and paid public invitations.
SUPABASE_SERVICE_ROLE_KEY=

# Browser key: restrict to your website origins and Maps JS / Places (New) / Maps Embed APIs.
# Enable billing and those three APIs in Google Cloud. Restart/rebuild after setting this.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cashfree secrets stay server-only. Never commit .env.local.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
NEXT_PUBLIC_CASHFREE_ENV=SANDBOX
# Use your canonical HTTPS domain for deployed checkout and webhook delivery.
NEXT_PUBLIC_APP_URL=http://localhost:3000
